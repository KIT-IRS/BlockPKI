@InProceedings{Riahi2024,
  author    = {Riahi, Kenza and Brahmia, Mohamed-El-Amine and Abouaissa, Abdelhafid and Idoumghar, Lhassane},
  booktitle = {Proceedings of the 2023 9th International Conference on Communication and Information Processing},
  title     = {A Comparative Study of Blockchain Development Platforms},
