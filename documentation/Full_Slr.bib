@Article{Tran2023,
  author       = {Tran, Quang Duy and Hoang Trong, Minh},
  journal      = {Thang Long Journal of Science: Mathematics and Mathematical Sciences},
  title        = {A blockchain-based Certificate Management System using the Hyperledger Fabric Platform},
  year         = {2023},
  month        = {Sep.},
